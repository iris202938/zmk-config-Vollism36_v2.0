#include "Vollism36.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/sensor_rotation.dtsi>
#include <input/processors/zmk-input-processor-keybind.dtsi>
// #include <dt-bindings/zmk/input.h>

#define QWE 0
#define NIC 1
#define LIN 2
#define NICL 3
#define CAD 4
#define WIN 5
#define LWR 6
#define LWRL 7
#define LWRW 8
#define RSE 9
#define RSEL 10
#define RSEW 11
#define ADJ 12
#define ADJL 13
#define ADJW 14
#define MOV 15
#define MOVL 16
#define MOVW 17
#define NUM 18
#define NUML 19
#define NUMW 20
#define WINS 21
#define BLE 22

/ {
    aliases {
        led-red = &led0;   /* Xiao BLE の赤色LEDラベル */
        led-green = &led1; /* Xiao BLE の緑色LEDラベル */
        led-blue = &led2;  /* Xiao BLE の青色LEDラベル */
    };
};

&kscan0 {
        col-gpios
            = <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 2 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 3 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 6 GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

/ {
    input_processors {
        sensor_rotation: sensor_rotation {
            compatible = "zmk,input-processor-sensor-rotation";
            #input-processor-cells = <0>;
            rotation-angle = <255>;
            // rotation-angle = <0>;
        };

        xy_to_keys: xy_to_keys {
            compatible = "zmk,input-processor-keybind";
            #input-processor-cells = <0>;
            bindings = <&kp RIGHT>, <&kp LEFT>, <&kp UP>, <&kp DOWN>;
            threshold = <2>; // 方向キーが勝手に入る場合はしきい値を少し上げる
            mode = <1>;
            tick = <40>; // ティック間隔
			wait-ms = <0>; // 待機時間
			tap-ms = <50>; // タップ時間
        };
    };
};

&trackball_listener {
    status = "okay";
    device = <&trackball>;

        /* ==========================================================
        Layer 22: BLE (通常マウス)
        ========================================================== */
        l_ble {
            layers = <BLE>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 50 100>; // スケーリング（50/100）
        };

        /* ==========================================================
        Layer 21: WINS (通常マウス)
        ========================================================== */
        l_wins {
            layers = <WINS>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 50 100>; // スケーリング（50/100）
        };

        /* ==========================================================
        Layer 20: NUMW (スクロール)
        ========================================================== */
        l_numw {
            layers = <NUMW>;
            input-processors = 
                <&sensor_rotation>,
                <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>,
                <&zip_xy_scaler 1 30>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_xy_scaler 0 1>; 
        };

        /* ==========================================================
        Layer 19: NUML (スクロール)
        ========================================================== */
        l_numl {
            layers = <NUML>;
            input-processors = 
                <&sensor_rotation>,
                <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>,
                <&zip_xy_scaler 1 30>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_xy_scaler 0 1>; 
        };

        /* ==========================================================
        Layer 18: NUM (スクロール)
        ========================================================== */
        l_num {
            layers = <NUM>;
            input-processors = 
                <&sensor_rotation>,
                <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>,
                <&zip_xy_scaler 1 30>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_xy_scaler 0 1>; 
        };

        /* ==========================================================
        Layer 17: MOVW (方向キー変換)
           ========================================================== */
        l_movw {
            layers = <MOVW>; 
            input-processors = 
                <&sensor_rotation>, 
                <&zip_xy_scaler 200 100>, 
                <&xy_to_keys>;
            process-next;
        };

        l_movw_prevent {
            layers = <MOVW>;
            input-processors = <&zip_xy_scaler 0 1>;
        };

        /* ==========================================================
        Layer 16: MOVL (方向キー変換)
        ========================================================== */
        l_movl {
            layers = <MOVL>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 30 100>; // スケーリング（30/100）
            // input-processors = 
            //     <&sensor_rotation>, 
            //     <&zip_xy_scaler 200 100>, 
            //     <&xy_to_keys>;
            // process-next;
        };

        // l_movl_prevent {
        //     layers = <MOVL>;
        //     input-processors = <&zip_xy_scaler 0 1>;
        // };

        /* ==========================================================
        Layer 15: MOV (方向キー変換)
        ========================================================== */
        l_mov {
            layers = <MOV>; 
            input-processors = 
                <&sensor_rotation>, 
                <&zip_xy_scaler 200 100>, 
                <&xy_to_keys>;
            process-next;
        };

        l_mov_prevent {
            layers = <MOV>;
            input-processors = <&zip_xy_scaler 0 1>;
        };

        /* ==========================================================
        Layer 14: ADJW (通常マウス)
        ========================================================== */
        l_adjw {
            layers = <ADJW>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 50 100>; // スケーリング（50/100）
        };

        /* ==========================================================
        Layer 13: ADJL (通常マウス)
        ========================================================== */
        l_adjl {
            layers = <ADJL>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 50 100>; // スケーリング（50/100）
        };

        /* ==========================================================
        Layer 12: ADJ (通常マウス)
        ========================================================== */
        l_adj {
            layers = <ADJ>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 60 100>; // スケーリング（60/100）
        };

        /* ==========================================================
        Layer 11: RSEW (スクロール)
        ========================================================== */
        l_rsew {
            layers = <RSEW>;
            input-processors = 
                <&sensor_rotation>,
                <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>,
                <&zip_xy_scaler 1 30>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_xy_scaler 0 1>; 
        };

        /* ==========================================================
        Layer 10: RSEL (スクロール)
        ========================================================== */
        l_rsel {
            layers = <RSEL>;
            input-processors = 
                <&sensor_rotation>,
                <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>,
                <&zip_xy_scaler 1 30>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_xy_scaler 0 1>; 
        };

        /* ==========================================================
        Layer 9: RSE (スクロール)
        ========================================================== */
        l_rse {
            layers = <RSE>;
            input-processors = 
                <&sensor_rotation>,
                <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>,
                <&zip_xy_scaler 1 30>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_xy_scaler 0 1>; 
        };

        /* ==========================================================
        Layer 8: LWRW (通常マウス)
        ========================================================== */
        l_lwrw {
            layers = <LWRW>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 50 100>; // スケーリング（50/100）
        };

        /* ==========================================================
        Layer 7: LWRL (通常マウス)
        ========================================================== */
        l_lwrl {
            layers = <LWRL>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 50 100>; // スケーリング（50/100）
        };

        /* ==========================================================
        Layer 6: LWR (通常マウス)
        ========================================================== */
        l_lwr {
            layers = <LWR>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 60 100>; // スケーリング（60/100）
        };

        /* ==========================================================
        Layer 5: WIN (通常マウス)
        ========================================================== */
        l_win {
            layers = <WIN>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 50 100>; // スケーリング（50/100）
        };

        /* ==========================================================
        Layer 4: CAD (通常マウス)
        ========================================================== */
        l_cad {
            layers = <CAD>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 50 100>; // スケーリング（50/100）
        };

        /* ==========================================================
        Layer 3: NICL (通常マウス)
        ========================================================== */
        l_nicl {
            layers = <NICL>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 50 100>; // スケーリング（50/100）
        };

        /* ==========================================================
        Layer 2: LIN (通常マウス)
        ========================================================== */
        l_lin {
            layers = <LIN>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 50 100>; // スケーリング（50/100）
        };

        /* ==========================================================
        Layer 1: NIC (通常マウス)
        ========================================================== */
        l_nic {
            layers = <NIC>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 60 100>; // スケーリング（60/100）
        };

        /* ==========================================================
        Layer 0: QWE (通常マウス)
        ========================================================== */
        l_qwe {
            layers = <QWE>;
            input-processors = <&sensor_rotation>
                             , <&zip_xy_scaler 60 100>; // スケーリング（60/100）
        };
    };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

/* 右から飛んでくるアナログスティック信号用のリスナー */
/ {
    zip_keybind_keys_directionL: zip_keybind_keys_directionL {
			compatible = "zmk,input-processor-keybind";
			#input-processor-cells = <0>;
		// track_remainders;
			bindings 
                = <&kp RIGHT>
				, <&kp LEFT>
				, <&kp UP>
				, <&kp DOWN>
				;
			tick = <150>;
			wait-ms = <100>;
			tap-ms = <50>;
			mode = <1>;
	};
	zip_keybind_keys_directionM: zip_keybind_keys_directionM {
			compatible = "zmk,input-processor-keybind";
			#input-processor-cells = <0>;
		// track_remainders;
			bindings
                = <&kp RIGHT>
				, <&kp LEFT>
				, <&kp UP>
				, <&kp DOWN>
				;
			tick = <100>; // ティック間隔
			wait-ms = <5>; // 待機時間
			tap-ms = <40>; // タップ時間
	};
	zip_keybind_keys_directionH: zip_keybind_keys_directionH {
			compatible = "zmk,input-processor-keybind";
			#input-processor-cells = <0>;
		// track_remainders;
			bindings
                = <&kp RIGHT>
				, <&kp LEFT>
				, <&kp UP>
				, <&kp DOWN>
				;
			tick = <50>; // ティック間隔
			wait-ms = <0>; // 待機時間
			tap-ms = <50>; // タップ時間
	};
    zip_keybind_keys_freecad: zip_keybind_keys_freecad {
		compatible = "zmk,input-processor-keybind";
		#input-processor-cells = <0>;
		track_remainders;
		bindings
            = <&kp N3>
			, <&kp N6>
			, <&kp N2>
			, <&kp N5>
			;
		tick = <150>;
		wait-ms = <100>;
		tap-ms = <50>;
		mode = <1>;
		// threshold = <10>
		// max_threshold = <200>
		// max_pending_activations = <10>
    };
    zip_keybind_keys_freecad_3d: zip_keybind_keys_freecad_3d {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
		// track_remainders;
        bindings 
            = <&mb3_mb1>
            , <&mb3_mb1>
            , <&mb3_mb1>
            , <&mb3_mb1>
            ;
        tick = <10>;       // 少しだけ持たせる（1だと重すぎる場合があるため10〜50程度に調整）
        wait-ms = <10>;    // 待ち時間を短く
        tap-ms = <20>;     // 500から大幅に小さくし、スティックを離したら即座に離す（例: 20〜50）
        mode = <1>;
	};

    peripheral_listener: peripheral_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_split>; /* 右から転送されてくる仮想デバイスを指定 */
        
        /* ここにスティック用のレイヤー設定などを記述 */
        r_layer22 {
			layers = <BLE>; // レイヤー22がアクティブな場合
            input-processors = <&zip_xy_scaler 40 100>; // 速度を40/100に設定 (乗数40, 除数100)
		// 	input-processors = <&zip_keybind_keys_directionH>; // zip_keybind_keys_directionH を使用
		// 	process-next; // 他のプロセッサも処理を継続
		// };
		// r_layer22-prevent {
		// 	layers = <BLE>; // レイヤー22がアクティブな場合
		// 	input-processors = <&zip_xy_scaler 0 1>; // ジョイスティックの動きをゼロにスケーリング（無効化）
		};
		r_layer21 {
			layers = <WINS>; // レイヤー21がアクティブな場合
			input-processors = <&zip_keybind_keys_directionH>; // zip_keybind_keys_directionH を使用
			process-next;
		};
		r_layer21-prevent {
			layers = <WINS>; // レイヤー21がアクティブな場合
			input-processors = <&zip_xy_scaler 0 1>; // ジョイスティックの動きをゼロにスケーリング（無効化）
		};
		r_layer20 {
			layers = <NUMW>; // レイヤー20がアクティブな場合
			input-processors = <&zip_keybind_keys_directionL>; // zip_keybind_keys_directionL を使用
			process-next; // 他のプロセッサも処理を継続
		};
		r_layer20-prevent {
			layers = <NUMW>; // レイヤー20がアクティブな場合
			input-processors = <&zip_xy_scaler 0 1>; // ジョイスティックの動きをゼロにスケーリング（無効化）
		};
		r_layer19 {
			layers = <NUML>; // レイヤー19がアクティブな場合
			input-processors = <&zip_keybind_keys_freecad>; // zip_keybind_keys_freecad を使用
			process-next; // 他のプロセッサも処理を継続
		};
		r_layer19-prevent {
			layers = <NUML>; // レイヤー19がアクティブな場合
			input-processors = <&zip_xy_scaler 0 1>; // ジョイスティックの動きをゼロにスケーリング（無効化）
		};
		r_layer18 {
			layers = <NUM>; // レイヤー18がアクティブな場合
			input-processors = <&zip_keybind_keys_directionL>; // zip_keybind_keys_directionL を使用
			process-next; // 他のプロセッサも処理を継続
		};
		r_layer18-prevent {
			layers = <NUM>; // レイヤー18がアクティブな場合
			input-processors = <&zip_xy_scaler 0 1>; // ジョイスティックの動きをゼロにスケーリング（無効化）
		};
		r_layer16 {
			layers = <MOVL>; // レイヤー16がアクティブな場合
			input-processors = <&zip_keybind_keys_directionM>; // zip_keybind_keys_directionM を使用
			process-next; // 他のプロセッサも処理を継続
		};
		r_layer16-prevent {
			layers = <MOVL>; // レイヤー16がアクティブな場合
			input-processors = <&zip_xy_scaler 0 1>; // ジョイスティックの動きをゼロにスケーリング（無効化）
		};
		r_layer15 {
			layers = <MOV>; // レイヤー15がアクティブな場合
			input-processors = <&zip_keybind_keys_directionM>; // zip_keybind_keys_directionM を使用
			process-next; // 他のプロセッサも処理を継続
		};
		r_layer15-prevent {
			layers = <MOV>; // レイヤー15がアクティブな場合
			input-processors = <&zip_xy_scaler 0 1>; // ジョイスティックの動きをゼロにスケーリング（無効化）
		};
		r_mouse_speed_full_l {
			layers = <ADJL>; // レイヤー13がアクティブな場合
			input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>
							, <&zip_xy_scaler 80 100>; // 速度を80/100に設定 (乗数80, 除数100)
		};
		r_mouse_speed_full {
			layers = <ADJ>; // レイヤー12がアクティブな場合
            input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>
							, <&zip_xy_scaler 80 100>; // 速度を80/100に設定 (乗数80, 除数100)
		};
		r_layer10_l {
			layers = <RSEL>; // レイヤー10がアクティブな場合
			input-processors = <&zip_keybind_keys_directionM>; // zip_keybind_keys_directionM を使用
			process-next; // 他のプロセッサも処理を継続
		};
		r_layer10_l-prevent {
			layers = <RSEL>; // レイヤー10がアクティブな場合
			input-processors = <&zip_xy_scaler 0 1>; // ジョイスティックの動きをゼロにスケーリング（無効化）
		};
		r_layer9 {
			layers = <RSE>; // レイヤー9がアクティブな場合
			input-processors = <&zip_keybind_keys_directionM>; // zip_keybind_keys_directionM を使用
			process-next; // 他のプロセッサも処理を継続
		};
		r_layer9-prevent {
			layers = <RSE>; // レイヤー9がアクティブな場合
			input-processors = <&zip_xy_scaler 0 1>; // ジョイスティックの動きをゼロにスケーリング（無効化）
		};
		r_scroll_w {
			layers = <LWRW>; // レイヤー8がアクティブな場合
			input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>
							, <&zip_xy_scaler 18 100> // スケーリング（18/100）
							, <&zip_xy_to_scroll_mapper>; // スクロールイベントにマッピング
		};
		r_scroll_l {
			layers = <LWRL>; // レイヤー7がアクティブな場合
            input-processors = <&zip_xy_scaler 40 100>; // 速度を40/100に設定 (乗数40, 除数100)
			// input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>
			// 				, <&zip_xy_scaler 18 100> // スケーリング（18/100）
			// 				, <&zip_xy_to_scroll_mapper>; // スクロールイベントにマッピング
		};
		r_scroll {
			layers = <LWR>; // レイヤー6がアクティブな場合
			input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>
							, <&zip_xy_scaler 8 100> // スケーリング（8/100）
							, <&zip_xy_to_scroll_mapper>; // スクロールイベントにマッピング
		};
		r_layer5 {
			layers = <WIN>; // レイヤー5がアクティブな場合
			input-processors = <&zip_keybind_keys_directionH>; // zip_keybind_keys_directionH を使用
			process-next;
		};
		r_layer5-prevent {
			layers = <WIN>; // レイヤー5がアクティブな場合
			input-processors = <&zip_xy_scaler 0 1>; // ジョイスティックの動きをゼロにスケーリング（無効化）
		};
		r_cad {
			layers = <CAD>; // レイヤー4がアクティブな場合
			input-processors = <&zip_keybind_keys_freecad_3d>; // zip_keybind_keys_freecad_3d を使用
			process-next;
		};
		r_cad-prevent {
			layers = <CAD>; // レイヤー4がアクティブな場合
			input-processors = <&zip_xy_scaler 32 100>; // スケーリング（32/100）
		};
		r_nicl {
			layers = <NICL>; // レイヤー3がアクティブな場合
			input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>
							, <&zip_xy_scaler 16 100> // スケーリング（16/100）
							, <&zip_xy_to_scroll_mapper>; // スクロールイベントにマッピング
		};
        r_lin {
			layers = <LIN>; // レイヤー2がアクティブな場合
            input-processors = <&zip_keybind_keys_freecad_3d>; // zip_keybind_keys_freecad_3d を使用
            process-next;
        };
        r_lin-prevent {
			layers = <LIN>; // レイヤー2がアクティブな場合
			input-processors = <&zip_xy_scaler 8 100>; // スケーリング（8/100）
		};
		r_nic {
			layers = <NIC>; // レイヤー2がアクティブな場合
			input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>
							, <&zip_xy_scaler 8 100> // スケーリング（8/100）
							, <&zip_xy_to_scroll_mapper>; // スクロールイベントにマッピング
		};
		r_default {
            layers = <QWE>;
            input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>
                            , <&zip_xy_scaler 4 100> // スケーリング（4/100）
                            , <&zip_xy_to_scroll_mapper>; // スクロールイベントにマッピング
        };
    };
    // peripheral_listener: peripheral_listener {
    //     compatible = "zmk,input-listener";
    //     device = <&joystick_split>; /* 右から転送されてくる仮想デバイスを指定 */
        
    //     /* ここにスティック用のレイヤー設定などを記述 */
    //     default {
    //         layers = <QWE>;
    //         input-processors = <&zip_xy_scaler 10 30>;
    //     };
};